title: $:/plugins/mblackman/kojima-media/config
tags: $:/tags/ControlPanel/SettingsTab
caption: Kojima Movie Tracker
type: text/vnd.tiddlywiki

<$let
  defaultUrl="https://mblackman.github.io/tiddlywiki-kojima-media/api/kojima-recommendations.json"
  currentUrl={{{ [[$:/plugins/mblackman/kojima-media/configs/kojima-sync-url]get[text]trim[]!is[blank]else<defaultUrl>] }}}
>
  <div class="kj-settings-panel">
    <div class="kj-settings-header">
      <h3 class="kj-settings-heading">🎬 Kojima Movie Tracker</h3>
      <p class="kj-settings-desc">
        Downloads Hideo Kojima's movie recommendations and 5-level enthusiasm ratings from a JSON feed while preserving your watch status (<code>Completed</code>, <code>Backlog</code>, <code>Active</code>, <code>Dropped</code>).
      </p>
    </div>

    <div class="kj-field-group">
      <label class="kj-label-stack">
        <span class="kj-label">Recommendations Feed URL</span>
        <$edit-text
          tiddler="$:/plugins/mblackman/kojima-media/configs/kojima-sync-url"
          tag="input"
          type="url"
          inputmode="url"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          default=<<defaultUrl>>
          placeholder=<<defaultUrl>>
          class="kj-input"
        />
      </label>
      <span class="kj-field-hint">
        Defaults to the official GitHub Pages feed (updated daily via GitHub Actions). You can also enter a custom feed URL.
      </span>

      <div class="kj-chip-group" role="group" aria-label="Feed URL Presets">
        <$button
          class={{{ [<currentUrl>match<defaultUrl>then[kj-chip kj-chip--active]else[kj-chip]] }}}
          aria-pressed={{{ [<currentUrl>match<defaultUrl>then[true]else[false]] }}}
        >
          <$action-setfield $tiddler="$:/plugins/mblackman/kojima-media/configs/kojima-sync-url" text=<<defaultUrl>> />
          ☁️ Official GitHub Pages Feed
        </$button>
      </div>
    </div>

    <div class="kj-settings-actions">
      <$button class="kj-btn kj-btn--primary" message="tm-sync-kojima">
        🔄 Sync Kojima Feed
      </$button>
      <$link to="Kojima Movie Recommendations" class="kj-btn">
        Open Dashboard →
      </$link>
      <$list filter="[[$:/state/kojima-sync/status]has[text]!field:text[]]" variable="ignoreSyncStatus">
        <span class="kj-sync-status" role="status" aria-live="polite">
          {{$:/state/kojima-sync/status}}
        </span>
      </$list>
    </div>
  </div>
</$let>
