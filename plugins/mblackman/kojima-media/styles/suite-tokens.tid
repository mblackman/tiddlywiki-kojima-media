title: $:/plugins/mblackman/kojima-media/styles/suite-tokens
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/* Standalone-safe fallback contract (specificity 0,0,0 via :where).
   Automatically overridden when Slipstream ($:/plugins/mblackman/slipstream) is active. */
:where(:root, .tc-page-container) {
  color-scheme: light dark;

  --suite-bg-canvas: var(--mn-bg-app, var(--tpc-page-background, <<colour page-background>>));
  --suite-surface-primary: var(--mn-bg-surface, var(--tpc-tiddler-background, <<colour tiddler-background>>));
  --suite-surface-card: var(--mn-bg-card, color-mix(in oklab, var(--tpc-tiddler-background, <<colour tiddler-background>>) 96.5%, var(--tpc-foreground, <<colour foreground>>) 3.5%));
  --suite-surface-subtle: var(--mn-bg-subtle, color-mix(in oklab, var(--tpc-tiddler-background, <<colour tiddler-background>>) 93%, var(--tpc-foreground, <<colour foreground>>) 7%));
  --suite-surface-elevated: var(--mn-bg-elevated, color-mix(in oklab, var(--tpc-tiddler-background, <<colour tiddler-background>>) 90%, var(--tpc-foreground, <<colour foreground>>) 10%));
  --suite-surface-input: var(--tpc-tiddler-background, <<colour tiddler-background>>);
  --suite-surface-hover: var(--mn-bg-hover, color-mix(in oklab, var(--tpc-foreground, <<colour foreground>>) 5.5%, var(--tpc-tiddler-background, <<colour tiddler-background>>)));
  --suite-surface-active: var(--mn-bg-active, color-mix(in oklab, var(--tpc-foreground, <<colour foreground>>) 9%, var(--tpc-tiddler-background, <<colour tiddler-background>>)));
  --suite-surface-selected: var(--mn-accent-soft, color-mix(in oklab, var(--tpc-primary, <<colour primary>>) 12%, var(--tpc-tiddler-background, <<colour tiddler-background>>)));
  --suite-surface-dropzone: color-mix(in oklab, var(--tpc-primary, <<colour primary>>) 8%, var(--suite-surface-subtle));

  --suite-fg-primary: var(--mn-fg-primary, var(--tpc-foreground, <<colour foreground>>));
  --suite-fg-secondary: var(--mn-fg-secondary, color-mix(in oklab, var(--tpc-foreground, <<colour foreground>>) 72%, var(--tpc-muted-foreground, <<colour muted-foreground>>) 28%));
  --suite-fg-muted: var(--mn-fg-muted, color-mix(in oklab, var(--tpc-foreground, <<colour foreground>>) 58%, var(--tpc-muted-foreground, <<colour muted-foreground>>) 42%));
  --suite-fg-on-accent: #ffffff;

  --suite-border-width: 1px;
  --suite-border-width-accent: 3px;
  --suite-border-hairline: var(--mn-border-hairline, color-mix(in oklab, var(--suite-fg-primary) 7%, transparent));
  --suite-border-subtle: var(--mn-border-subtle, color-mix(in oklab, var(--suite-fg-primary) 12%, transparent));
  --suite-border-strong: var(--mn-border-strong, color-mix(in oklab, var(--suite-fg-primary) 22%, transparent));
  --suite-border-control: var(--mn-border-control, color-mix(in oklab, var(--suite-fg-primary) 46%, var(--suite-surface-primary)));

  --suite-radius-xs: 6px;
  --suite-radius-sm: 8px;
  --suite-radius-md: 10px;
  --suite-radius-lg: 14px;
  --suite-radius-xl: 18px;
  --suite-radius-pill: 9999px;

  --suite-shadow-xs: 0 1px 2px rgba(15, 23, 42, 0.04);
  --suite-shadow-sm: var(--mn-shadow-card, 0 2px 8px -2px rgba(15, 23, 42, 0.06), 0 1px 3px -1px rgba(15, 23, 42, 0.04));
  --suite-shadow-md: 0 6px 16px -4px rgba(15, 23, 42, 0.10), 0 2px 6px -1px rgba(15, 23, 42, 0.05);
  --suite-shadow-lg: var(--mn-shadow-popover, 0 12px 32px -4px rgba(15, 23, 42, 0.16), 0 4px 12px -2px rgba(15, 23, 42, 0.08));
  --suite-scrim: var(--mn-scrim, rgba(15, 23, 42, 0.45));

  --suite-space-1: 0.25rem;
  --suite-space-2: 0.5rem;
  --suite-space-3: 0.75rem;
  --suite-space-4: 1rem;
  --suite-space-5: 1.25rem;
  --suite-space-6: 1.5rem;
  --suite-space-8: 2rem;

  --suite-card-padding-sm: 0.625rem 0.75rem;
  --suite-card-padding-md: 0.875rem 1rem;
  --suite-card-padding-lg: 1.125rem 1.25rem;
  --suite-card-gap: 0.75rem;
  --suite-section-gap: 1.25rem;
  --suite-row-padding-y: 0.5rem;

  --suite-control-height-sm: 30px;
  --suite-control-height-md: 36px;
  --suite-control-height-lg: 44px;
  --suite-touch-target: 36px;

  --suite-font-sans: var(--mn-font-sans, -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif);
  --suite-font-mono: var(--mn-font-mono, "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace);

  --suite-text-xs: 0.75rem;
  --suite-text-sm: 0.84rem;
  --suite-text-base: 0.9375rem;
  --suite-text-lg: 1.125rem;
  --suite-text-xl: 1.375rem;

  --suite-tracking-label: 0.04em;
  --suite-leading-tight: 1.25;
  --suite-leading-normal: 1.5;
  --suite-leading-relaxed: 1.68;

  --suite-accent: var(--mn-accent, var(--tpc-primary, <<colour primary>>));
  --suite-accent-hover: var(--mn-accent-hover, color-mix(in oklab, var(--suite-accent) 86%, var(--suite-fg-primary)));
  --suite-accent-bg: var(--mn-accent-soft, color-mix(in oklab, var(--suite-accent) 12%, var(--suite-surface-primary)));
  --suite-accent-border: color-mix(in oklab, var(--suite-accent) 30%, transparent);
  accent-color: var(--suite-accent);

  --suite-status-success-accent: #10b981;
  --suite-status-success-fg: color-mix(in oklab, #059669 82%, var(--suite-fg-primary));
  --suite-status-success-bg: color-mix(in oklab, #10b981 13%, var(--suite-surface-primary));
  --suite-status-success-border: color-mix(in oklab, #10b981 32%, transparent);

  --suite-status-warning-accent: #f59e0b;
  --suite-status-warning-fg: color-mix(in oklab, #d97706 82%, var(--suite-fg-primary));
  --suite-status-warning-bg: color-mix(in oklab, #f59e0b 14%, var(--suite-surface-primary));
  --suite-status-warning-border: color-mix(in oklab, #f59e0b 35%, transparent);

  --suite-status-danger-accent: var(--mn-danger, var(--tpc-alert-highlight, #ef4444));
  --suite-status-danger-fg: color-mix(in oklab, var(--suite-status-danger-accent) 85%, var(--suite-fg-primary));
  --suite-status-danger-bg: color-mix(in oklab, var(--suite-status-danger-accent) 12%, var(--suite-surface-primary));
  --suite-status-danger-border: color-mix(in oklab, var(--suite-status-danger-accent) 32%, transparent);

  --suite-status-info-accent: #3b82f6;
  --suite-status-info-fg: color-mix(in oklab, #2563eb 82%, var(--suite-fg-primary));
  --suite-status-info-bg: color-mix(in oklab, #3b82f6 12%, var(--suite-surface-primary));
  --suite-status-info-border: color-mix(in oklab, #3b82f6 30%, transparent);

  --suite-focus-ring: 0 0 0 3px color-mix(in oklab, var(--suite-accent) 28%, transparent);

  --tw-suite-bg-canvas: var(--suite-bg-canvas);
  --tw-suite-surface-primary: var(--suite-surface-primary);
  --tw-suite-surface-card: var(--suite-surface-card);
  --tw-suite-surface-subtle: var(--suite-surface-subtle);
  --tw-suite-surface-elevated: var(--suite-surface-elevated);
  --tw-suite-surface-hover: var(--suite-surface-hover);
  --tw-suite-surface-active: var(--suite-surface-active);
  --tw-suite-surface-dropzone: var(--suite-surface-dropzone);
  --tw-suite-fg-primary: var(--suite-fg-primary);
  --tw-suite-fg-secondary: var(--suite-fg-secondary);
  --tw-suite-fg-muted: var(--suite-fg-muted);
  --tw-suite-border-subtle: var(--suite-border-subtle);
  --tw-suite-border-strong: var(--suite-border-strong);
  --tw-suite-border-control: var(--suite-border-control);
  --tw-suite-radius-sm: var(--suite-radius-sm);
  --tw-suite-radius-md: var(--suite-radius-md);
  --tw-suite-radius-lg: var(--suite-radius-lg);
  --tw-suite-radius-pill: var(--suite-radius-pill);
  --tw-suite-accent: var(--suite-accent);
}

:where([data-suite-density="compact"], .suite-density-compact) {
  --suite-row-padding-y: 0.25rem;
  --suite-card-padding-sm: 0.45rem 0.625rem;
  --suite-card-gap: 0.5rem;
}

:where([data-suite-density="touch"], .suite-density-touch) {
  --suite-control-height-sm: 36px;
  --suite-control-height-md: 44px;
  --suite-touch-target: 44px;
}

:where([data-suite-density="editorial"], .suite-density-editorial) {
  max-inline-size: var(--suite-measure-reading, 65ch);
  line-height: var(--suite-leading-relaxed, 1.68);
  text-wrap: pretty;
}

@media (prefers-contrast: more) {
  :where(:root, .tc-page-container) {
    --suite-border-subtle: color-mix(in oklab, var(--suite-fg-primary) 28%, transparent);
    --suite-border-control: color-mix(in oklab, var(--suite-fg-primary) 68%, var(--suite-surface-primary));
  }
}

@media (max-width: 640px), (pointer: coarse) {
  :where(:root, .tc-page-container) {
    --suite-control-height-sm: 36px;
    --suite-control-height-md: 44px;
    --suite-touch-target: 44px;
  }
}
